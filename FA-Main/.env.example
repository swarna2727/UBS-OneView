# Copy this file to .env and fill in the key. .env is ignored by git: never commit it.
# Only needed for Live mode; Offline mode, the tests and the evaluation run without it.
OPENROUTER_API_KEY=

# Optional
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5           # default model for every agent
# OPENROUTER_MODEL_OPPORTUNITYAGENT=openai/gpt-4.1        # per-agent override: OPENROUTER_MODEL_<AGENTNAME>
# OPENROUTER_MODEL_TRANSCRIPTION=google/gemini-2.5-flash  # audio transcription for the Record use case
# ONEVIEW_TOOL_TRANSPORT=direct                           # direct (default) or mcp
# RUN_LOG_DIR=data/runs                                   # where audit run logs are written
